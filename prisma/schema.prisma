generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =====================================================
// USER
// =====================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  role        Role    @default(SITE_ENGINEER)
  phoneNumber String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Authentication
  accounts Account[]

  // Projects
  managedProjects Project[] @relation("ProjectManager")
  createdProjects Project[] @relation("ProjectCreator")

  // Reports
  dailyReports DailyReport[]

  // Material requests
  materialRequests MaterialRequest[] @relation("RequestedBy")
  approvedRequests MaterialRequest[] @relation("ApprovedBy")

  // Material issuance
  issuedMaterials MaterialIssuance[]

  // Expenses
  recordedExpenses Expense[]

  // Uploaded project documents
  uploadedDocuments ProjectDocument[]

  @@map("users")
}

// =====================================================
// PROJECT
// =====================================================

model Project {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  description String? @db.Text
  location    String

  budget Float

  status ProjectStatus @default(PLANNED)

  startDate DateTime
  endDate   DateTime?

  creatorId String
  managerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Users
  creator User @relation("ProjectCreator", fields: [creatorId], references: [id])

  manager User? @relation("ProjectManager", fields: [managerId], references: [id])

  // Project activities
  tasks Task[]

  // Workers
  workforce WorkerAssignment[]

  // Attendance
  attendances Attendance[]

  // Daily reports
  dailyReports DailyReport[]

  // Materials
  materialRequests  MaterialRequest[]
  materialIssuances MaterialIssuance[]

  // Expenses
  expenses Expense[]

  // AI
  aiPredictions AiPrediction[]

  // Supporting Documents
  documents ProjectDocument[]

  @@map("projects")
}

// =====================================================
// TASK
// =====================================================

model Task {
  id        String @id @default(cuid())
  projectId String

  name        String
  description String? @db.Text

  status TaskStatus @default(PENDING)

  startDate   DateTime
  dueDate     DateTime
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

// =====================================================
// WORKER
// =====================================================

model Worker {
  id          String  @id @default(cuid())
  fullName    String
  nationalId  String? @unique
  phoneNumber String?

  // Example:
  // Mason
  // Carpenter
  // Electrician
  trade String

  dailyWage Float

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  assignments WorkerAssignment[]
  attendances Attendance[]

  @@map("workers")
}

// =====================================================
// WORKER ASSIGNMENT
// =====================================================

model WorkerAssignment {
  id        String @id @default(cuid())
  workerId  String
  projectId String

  assignedAt DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([workerId, projectId])
  @@map("worker_assignments")
}

// =====================================================
// ATTENDANCE
// =====================================================

model Attendance {
  id        String @id @default(cuid())
  workerId  String
  projectId String

  date DateTime @db.Date

  status AttendanceStatus @default(PRESENT)

  hoursWorked Float @default(8.0)

  createdAt DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([workerId, projectId, date])
  @@map("attendances")
}

// =====================================================
// DAILY REPORT
// =====================================================

model DailyReport {
  id         String @id @default(cuid())
  projectId  String
  engineerId String

  date DateTime @default(now()) @db.Date

  workSummary String @db.Text

  weatherCondition String?

  issues String? @db.Text

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  engineer User @relation(fields: [engineerId], references: [id])

  @@map("daily_reports")
}

// =====================================================
// MATERIAL
// =====================================================

model Material {
  id   String @id @default(cuid())
  name String @unique

  // Bags, Kg, Meters, Tons, etc.
  unit String

  quantity Int @default(0)

  unitPrice Float

  reorderLevel Int @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  requestItems  MaterialRequestItem[]
  issuanceItems MaterialIssuanceItem[]
  purchaseItems PurchaseOrderItem[]

  @@map("materials")
}

// =====================================================
// MATERIAL REQUEST
// =====================================================

model MaterialRequest {
  id String @id @default(cuid())

  projectId String

  requestedBy String
  approvedBy  String?

  status RequestStatus @default(PENDING)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  requester User @relation("RequestedBy", fields: [requestedBy], references: [id])

  approver User? @relation("ApprovedBy", fields: [approvedBy], references: [id])

  items MaterialRequestItem[]

  @@map("material_requests")
}

// =====================================================
// MATERIAL REQUEST ITEM
// =====================================================

model MaterialRequestItem {
  id                String @id @default(cuid())
  materialRequestId String
  materialId        String

  quantityRequested Int

  request MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)

  material Material @relation(fields: [materialId], references: [id])

  @@map("material_request_items")
}

// =====================================================
// MATERIAL ISSUANCE
// =====================================================

model MaterialIssuance {
  id        String @id @default(cuid())
  projectId String
  issuedBy  String

  // Name/role of person receiving material
  issuedTo String

  issuedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  issuer User @relation(fields: [issuedBy], references: [id])

  items MaterialIssuanceItem[]

  @@map("material_issuances")
}

// =====================================================
// MATERIAL ISSUANCE ITEM
// =====================================================

model MaterialIssuanceItem {
  id                 String @id @default(cuid())
  materialIssuanceId String
  materialId         String

  quantityIssued Int

  issuance MaterialIssuance @relation(fields: [materialIssuanceId], references: [id], onDelete: Cascade)

  material Material @relation(fields: [materialId], references: [id])

  @@map("material_issuance_items")
}

// =====================================================
// SUPPLIER
// =====================================================

model Supplier {
  id String @id @default(cuid())

  name        String
  contactName String?
  email       String?
  phone       String
  address     String?

  createdAt DateTime @default(now())

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

// =====================================================
// PURCHASE ORDER
// =====================================================

model PurchaseOrder {
  id         String @id @default(cuid())
  supplierId String

  totalAmount Float

  status OrderStatus @default(PENDING)

  orderedAt  DateTime  @default(now())
  receivedAt DateTime?

  supplier Supplier @relation(fields: [supplierId], references: [id])

  items PurchaseOrderItem[]

  expenses Expense[]

  @@map("purchase_orders")
}

// =====================================================
// PURCHASE ORDER ITEM
// =====================================================

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  materialId      String

  quantity  Int
  unitPrice Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  material Material @relation(fields: [materialId], references: [id])

  @@map("purchase_order_items")
}

// =====================================================
// EXPENSE
// =====================================================

model Expense {
  id              String  @id @default(cuid())
  projectId       String
  recordedById    String
  purchaseOrderId String?

  category ExpenseCategory

  amount Float

  description String? @db.Text

  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  recordedBy User @relation(fields: [recordedById], references: [id])

  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@map("expenses")
}

// =====================================================
// AI PREDICTION
// =====================================================

model AiPrediction {
  id        String @id @default(cuid())
  projectId String

  predictionType PredictionType

  // Predicted cost, delay days, etc.
  predictedValue Float

  // AI confidence: 0.0 - 1.0
  confidence Float

  riskLevel RiskLevel @default(MEDIUM)

  // AI explanation
  insights String @db.Text

  generatedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("ai_predictions")
}

// =====================================================
// ENUMS
// =====================================================

enum Role {
  GENERAL_MANAGER
  PROJECT_MANAGER
  HR_MANAGER
  SITE_ENGINEER
  PROCUREMENT_OFFICER
  ACCOUNTANT
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

enum OrderStatus {
  PENDING
  ORDERED
  DELIVERED
  CANCELLED
}

enum ExpenseCategory {
  LABOR
  MATERIALS
  EQUIPMENT
  LOGISTICS
  MISCELLANEOUS
}

enum PredictionType {
  COST_OVERRUN
  SCHEDULE_DELAY
  RESOURCE_FORECAST
  RISK_ANALYSIS
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// =====================================================
// PROJECT SUPPORTING DOCUMENTS & FILES
// =====================================================

model ProjectDocument {
  id          String           @id @default(cuid())
  projectId   String
  uploaderId  String

  name        String
  fileUrl     String
  fileType    String
  fileSize    Int
  category    DocumentCategory @default(OTHER)
  description String?          @db.Text

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaderId], references: [id])

  @@map("project_documents")
}

enum DocumentCategory {
  BLUEPRINT
  CONTRACT
  PERMIT
  SPECIFICATION
  BOQ_ESTIMATE
  SITE_PHOTO
  INVOICE_RECEIPT
  OTHER
}
